# Shamba Circle — Next.js app environment variables
#
# This file documents the environment variables the app needs. It is safe to
# commit — it contains no real secrets, only placeholder names.
#
# To use it locally, once the Supabase project exists (Phase 0, Step 1 —
# supabase.com account setup, done outside this repo):
#   1. Copy this file to .env.local in this same web/ folder
#   2. Replace the placeholder values with the real ones from
#      Supabase Dashboard > Project Settings > API
# .env.local is gitignored and must never be committed.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Anon (public) API key — safe for client-side use, protected by
# Row-Level Security policies on the database tables it can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
