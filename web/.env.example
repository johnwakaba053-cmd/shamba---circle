# Shamba Circle — Next.js app environment variables
#
# This file documents the environment variables the app needs. It is safe to
# commit — it contains no real secrets, only placeholder names.
#
# To use it locally, once the Supabase project exists (Phase 0, Step 1 —
# supabase.com account setup, done outside this repo):
#   1. Copy this file to .env.local in this same web/ folder
#   2. Replace the placeholder values with the real ones from
#      Supabase Dashboard > Project Settings > API
# .env.local is gitignored and must never be committed.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# Anon (public) API key — safe for client-side use, protected by
# Row-Level Security policies on the database tables it can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-only (Stage 4: weather ingestion) ---
# None of the variables below use the NEXT_PUBLIC_ prefix, so Next.js
# never bundles them into client-side code. They are only read from
# server-only modules (web/src/lib/weather/*, web/src/lib/supabase/admin.ts,
# and the internal ingestion route handler) — never from a "use client"
# file, and never logged or returned in any API response.

# Service-role key — Supabase Dashboard > Project Settings > API. Bypasses
# Row-Level Security entirely; used only by the server-side weather
# ingestion job to write into alerts/alert_counties, which have no
# authenticated-role policies at all by design (see Stage 1).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WeatherAPI.com API key — https://www.weatherapi.com/. Used only by
# web/src/lib/weather/weatherApiClient.ts for server-side requests; never
# sent to or readable by the browser.
WEATHER_API_KEY=your-weatherapi-key-here

# Shared secret required (as an `x-ingest-secret` header) to call the
# internal weather-ingestion route handler
# (POST /api/internal/ingest-weather-alerts). Generate any long random
# string for local development. Without this set, the endpoint refuses
# every request rather than running unauthenticated.
INGEST_SECRET=a-long-random-string-you-generate-locally
